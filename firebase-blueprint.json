{
  "entities": {
    "RegisteredSchool": {
      "title": "RegisteredSchool",
      "description": "Entitas satuan pendidikan dan metadata penyimpanan per sekolah",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "npsn": { "type": "string" },
        "address": { "type": "string" },
        "principalName": { "type": "string" },
        "academicYear": { "type": "string" },
        "semester": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "TeacherProfile": {
      "title": "TeacherProfile",
      "description": "Profil guru dan data akademis sekolah",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "nip": { "type": "string" },
        "npsn": { "type": "string" },
        "schoolName": { "type": "string" },
        "guardianClass": { "type": "string" },
        "subjectRole": { "type": "string" },
        "academicYear": { "type": "string" },
        "semester": { "type": "string" },
        "kkm": { "type": "number" },
        "principalName": { "type": "string" },
        "principalNip": { "type": "string" }
      },
      "required": ["name", "schoolName", "nip"]
    },
    "Student": {
      "title": "Student",
      "description": "Data peserta didik",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nis": { "type": "string" },
        "nisn": { "type": "string" },
        "name": { "type": "string" },
        "gender": { "type": "string" },
        "className": { "type": "string" },
        "parentName": { "type": "string" },
        "parentPhone": { "type": "string" },
        "status": { "type": "string" },
        "schoolName": { "type": "string" },
        "schoolId": { "type": "string" }
      },
      "required": ["id", "nis", "name", "className"]
    },
    "StudentGrade": {
      "title": "StudentGrade",
      "description": "Nilai capaian pembelajaran siswa",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "subjectId": { "type": "string" },
        "tp1": { "type": "number" },
        "tp2": { "type": "number" },
        "tp3": { "type": "number" },
        "tp4": { "type": "number" },
        "pts": { "type": "number" },
        "pas": { "type": "number" },
        "finalScore": { "type": "number" },
        "predicate": { "type": "string" },
        "achievementDescription": { "type": "string" },
        "schoolName": { "type": "string" },
        "schoolId": { "type": "string" }
      },
      "required": ["studentId", "subjectId"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Catatan presensi harian siswa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "note": { "type": "string" },
        "recordedAt": { "type": "string" },
        "schoolName": { "type": "string" },
        "schoolId": { "type": "string" }
      },
      "required": ["id", "studentId", "date", "status"]
    },
    "TeachingLog": {
      "title": "TeachingLog",
      "description": "Jurnal agenda mengajar guru",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "className": { "type": "string" },
        "subjectId": { "type": "string" },
        "classPeriod": { "type": "string" },
        "learningObjective": { "type": "string" },
        "summaryMaterial": { "type": "string" },
        "presentCount": { "type": "number" },
        "absentCount": { "type": "number" },
        "notes": { "type": "string" },
        "schoolName": { "type": "string" },
        "schoolId": { "type": "string" }
      },
      "required": ["id", "date", "className"]
    },
    "StudentTask": {
      "title": "StudentTask",
      "description": "Data tugas tambahan, remedial, pengayaan, dan penilaian siswa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "className": { "type": "string" },
        "subjectId": { "type": "string" },
        "dueDate": { "type": "string" },
        "assignedDate": { "type": "string" },
        "maxScore": { "type": "number" },
        "status": { "type": "string" },
        "description": { "type": "string" },
        "submittedCount": { "type": "number" },
        "totalStudents": { "type": "number" },
        "schoolName": { "type": "string" },
        "schoolId": { "type": "string" }
      },
      "required": ["id", "title", "category", "className"]
    }
  },
  "firestore": {
    "/schools/{schoolId}": {
      "schema": "RegisteredSchool",
      "description": "Dokumen registrasi sekolah terdaftar"
    },
    "/schools/{schoolId}/students/{studentId}": {
      "schema": "Student",
      "description": "Koleksi data peserta didik khusus pada penyimpanan masing-masing sekolah"
    },
    "/schools/{schoolId}/grades/{gradeId}": {
      "schema": "StudentGrade",
      "description": "Koleksi nilai capaian pembelajaran dan TP siswa pada sekolah tersebut"
    },
    "/schools/{schoolId}/attendance/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "Koleksi presensi harian siswa pada sekolah tersebut"
    },
    "/schools/{schoolId}/teachingLogs/{logId}": {
      "schema": "TeachingLog",
      "description": "Koleksi jurnal agenda mengajar harian pada sekolah tersebut"
    },
    "/schools/{schoolId}/studentTasks/{taskId}": {
      "schema": "StudentTask",
      "description": "Koleksi penugasan dan evaluasi siswa pada sekolah tersebut"
    },
    "/schools/{schoolId}/settings/{settingId}": {
      "schema": "TeacherProfile",
      "description": "Pengaturan mata pelajaran, rombel, dan kalender pada sekolah tersebut"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Fallback koleksi data peserta didik global"
    },
    "/grades/{gradeId}": {
      "schema": "StudentGrade",
      "description": "Fallback koleksi nilai capaian pembelajaran dan TP siswa"
    },
    "/attendance/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "Fallback koleksi presensi harian siswa"
    },
    "/teachingLogs/{logId}": {
      "schema": "TeachingLog",
      "description": "Fallback koleksi jurnal agenda mengajar harian"
    },
    "/studentTasks/{taskId}": {
      "schema": "StudentTask",
      "description": "Fallback koleksi penugasan dan evaluasi siswa"
    }
  }
}
